[
  {
    "id": "advanced-convergence",
    "title": {
      "en": "Advanced Convergence Training",
      "ru": "Продвинутая тренировка конвергенции",
      "ro": "Antrenament avansat de convergență"
    },
    "description": {
      "en": "Strengthen eye convergence for better near-vision focus",
      "ru": "Укрепите конвергенцию глаз для лучшего фокуса на близких объектах",
      "ro": "Întăriți convergența oculară pentru o focalizare mai bună la distanță apropiată"
    },
    "duration_sec": 90,
    "difficulty": "intermediate",
    "steps": [
      {
        "step_num": 1,
        "instruction": {
          "en": "Hold a pen at arm's length",
          "ru": "Держите ручку на расстоянии вытянутой руки",
          "ro": "Țineți un stilou la distanța brațului"
        },
        "duration_sec": 5,
        "audio_base64": null,
        "audio_phrase_id": "hold_pen_arm_length"
      },
      {
        "step_num": 2,
        "instruction": {
          "en": "Focus on the pen tip and slowly bring it toward your nose",
          "ru": "Сфокусируйтесь на кончике ручки и медленно приближайте к носу",
          "ro": "Concentrați-vă pe vârful stiloului și apropiați-l încet de nas"
        },
        "duration_sec": 20,
        "audio_base64": null
      },
      {
        "step_num": 3,
        "instruction": {
          "en": "Hold at the closest comfortable point for 10 seconds",
          "ru": "Удерживайте в ближайшей удобной точке 10 секунд",
          "ro": "Mențineți în cel mai apropiat punct confortabil timp de 10 secunde"
        },
        "duration_sec": 10,
        "audio_base64": null
      },
      {
        "step_num": 4,
        "instruction": {
          "en": "Slowly move the pen back to arm's length",
          "ru": "Медленно отведите ручку обратно на расстояние вытянутой руки",
          "ro": "Mișcați încet stiloul înapoi la distanța brațului"
        },
        "duration_sec": 20,
        "audio_base64": null
      },
      {
        "step_num": 5,
        "instruction": {
          "en": "Repeat the cycle 2 more times",
          "ru": "Повторите цикл еще 2 раза",
          "ro": "Repetați ciclul încă de 2 ori"
        },
        "duration_sec": 30,
        "audio_base64": null
      },
      {
        "step_num": 6,
        "instruction": {
          "en": "Close eyes and rest",
          "ru": "Закройте глаза и отдохните",
          "ro": "Închideți ochii și odihniți-vă"
        },
        "duration_sec": 5,
        "audio_base64": null
      }
    ],
    "is_premium": true,
    "has_audio": true,
    "tags": [
      "advanced",
      "near-vision",
      "strength"
    ]
  },
  {
    "id": "peripheral-awareness",
    "title": {
      "en": "Peripheral Vision Expansion",
      "ru": "Расширение периферического зрения",
      "ro": "Extinderea viziunii periferice"
    },
    "description": {
      "en": "Improve peripheral awareness while maintaining central focus",
      "ru": "Улучшите периферическое восприятие с сохранением центрального фокуса",
      "ro": "Îmbunătățiți conștientizarea periferică menținând focalizarea centrală"
    },
    "duration_sec": 75,
    "difficulty": "intermediate",
    "steps": [
      {
        "step_num": 1,
        "instruction": {
          "en": "Look straight ahead at a fixed point",
          "ru": "Смотрите прямо на фиксированную точку",
          "ro": "Uitați-vă drept înainte la un punct fix"
        },
        "duration_sec": 5,
        "audio_base64": null
      },
      {
        "step_num": 2,
        "instruction": {
          "en": "Without moving eyes, notice what you can see to the sides",
          "ru": "Не двигая глазами, заметьте, что видите по бокам",
          "ro": "Fără a mișca ochii, observați ce puteți vedea lateral"
        },
        "duration_sec": 15,
        "audio_base64": null
      },
      {
        "step_num": 3,
        "instruction": {
          "en": "Extend arms to sides, wiggle fingers slowly",
          "ru": "Вытяните руки в стороны, медленно шевелите пальцами",
          "ro": "Extindeți brațele lateral, mișcați degetele încet"
        },
        "duration_sec": 20,
        "audio_base64": null
      },
      {
        "step_num": 4,
        "instruction": {
          "en": "Keep eyes forward, notice finger movement in periphery",
          "ru": "Глаза прямо, заметьте движение пальцев периферическим зрением",
          "ro": "Mențineți ochii înainte, observați mișcarea degetelor în periferie"
        },
        "duration_sec": 20,
        "audio_base64": null
      },
      {
        "step_num": 5,
        "instruction": {
          "en": "Slowly bring arms forward into central vision",
          "ru": "Медленно переместите руки вперед в центральное зрение",
          "ro": "Aduceți încet brațele înainte în viziunea centrală"
        },
        "duration_sec": 10,
        "audio_base64": null
      },
      {
        "step_num": 6,
        "instruction": {
          "en": "Blink and relax",
          "ru": "Моргните и расслабьтесь",
          "ro": "Clipiți și relaxați-vă"
        },
        "duration_sec": 5,
        "audio_base64": null
      }
    ],
    "is_premium": true,
    "has_audio": false,
    "tags": [
      "advanced",
      "awareness",
      "comprehensive"
    ]
  },
  {
    "id": "accommodation-stamina",
    "title": {
      "en": "Accommodation Stamina Builder",
      "ru": "Развитие выносливости аккомодации",
      "ro": "Constructor de rezistență la acomodare"
    },
    "description": {
      "en": "Extended near-far focus switching to build accommodation endurance",
      "ru": "Продолжительное переключение между близким и дальним фокусом для выносливости аккомодации",
      "ro": "Comutare extinsă a focalizării aproape-departe pentru a construi rezistență la acomodare"
    },
    "duration_sec": 120,
    "difficulty": "intermediate",
    "steps": [
      {
        "step_num": 1,
        "instruction": {
          "en": "Choose a near object (book) and far object (window)",
          "ru": "Выберите близкий объект (книгу) и дальний объект (окно)",
          "ro": "Alegeți un obiect apropiat (carte) și un obiect îndepărtat (fereastră)"
        },
        "duration_sec": 10,
        "audio_base64": null
      },
      {
        "step_num": 2,
        "instruction": {
          "en": "Focus on near object for 10 seconds",
          "ru": "Сфокусируйтесь на близком объекте 10 секунд",
          "ro": "Concentrați-vă pe obiectul apropiat timp de 10 secunde"
        },
        "duration_sec": 10,
        "audio_base64": null
      },
      {
        "step_num": 3,
        "instruction": {
          "en": "Quickly shift to far object, hold focus 10 seconds",
          "ru": "Быстро переключитесь на дальний объект, удерживайте фокус 10 секунд",
          "ro": "Comutați rapid la obiectul îndepărtat, mențineți focalizarea 10 secunde"
        },
        "duration_sec": 10,
        "audio_base64": null
      },
      {
        "step_num": 4,
        "instruction": {
          "en": "Alternate between near and far 8 times",
          "ru": "Чередуйте близкий и дальний фокус 8 раз",
          "ro": "Alternați între apropiat și îndepărtat de 8 ori"
        },
        "duration_sec": 80,
        "audio_base64": null
      },
      {
        "step_num": 5,
        "instruction": {
          "en": "Close eyes and rest",
          "ru": "Закройте глаза и отдохните",
          "ro": "Închideți ochii și odihniți-vă"
        },
        "duration_sec": 10,
        "audio_base64": null
      }
    ],
    "is_premium": true,
    "has_audio": false,
    "tags": [
      "advanced",
      "endurance",
      "focus"
    ]
  },
  {
    "id": "3d-tracking",
    "title": {
      "en": "3D Object Tracking",
      "ru": "Отслеживание 3D-объектов",
      "ro": "Urmărire obiect 3D"
    },
    "description": {
      "en": "Follow a moving object through 3D space to improve tracking coordination",
      "ru": "Следуйте за движущимся объектом в 3D-пространстве для улучшения координации отслеживания",
      "ro": "Urmăriți un obiect în mișcare prin spațiul 3D pentru a îmbunătăți coordonarea urmăririi"
    },
    "duration_sec": 80,
    "difficulty": "intermediate",
    "steps": [
      {
        "step_num": 1,
        "instruction": {
          "en": "Hold a ball or object in your hand",
          "ru": "Держите мяч или объект в руке",
          "ro": "Țineți o minge sau un obiect în mână"
        },
        "duration_sec": 5,
        "audio_base64": null
      },
      {
        "step_num": 2,
        "instruction": {
          "en": "Move object in a circle, follow with eyes only",
          "ru": "Двигайте объект по кругу, следите только глазами",
          "ro": "Mișcați obiectul în cerc, urmăriți doar cu ochii"
        },
        "duration_sec": 20,
        "audio_base64": null
      },
      {
        "step_num": 3,
        "instruction": {
          "en": "Move object in a figure-eight pattern",
          "ru": "Двигайте объект в форме восьмерки",
          "ro": "Mișcați obiectul într-un model în formă de opt"
        },
        "duration_sec": 20,
        "audio_base64": null
      },
      {
        "step_num": 4,
        "instruction": {
          "en": "Move object toward and away from face",
          "ru": "Двигайте объект к лицу и от лица",
          "ro": "Mișcați obiectul spre și departe de față"
        },
        "duration_sec": 20,
        "audio_base64": null
      },
      {
        "step_num": 5,
        "instruction": {
          "en": "Combine movements, keep eyes tracking smoothly",
          "ru": "Комбинируйте движения, глаза следят плавно",
          "ro": "Combinați mișcările, ochii urmăresc lin"
        },
        "duration_sec": 10,
        "audio_base64": null
      },
      {
        "step_num": 6,
        "instruction": {
          "en": "Rest and blink",
          "ru": "Отдохните и моргните",
          "ro": "Odihniți-vă și clipiți"
        },
        "duration_sec": 5,
        "audio_base64": null
      }
    ],
    "is_premium": true,
    "has_audio": false,
    "tags": [
      "advanced",
      "coordination",
      "tracking"
    ]
  },
  {
    "id": "visual-meditation",
    "title": {
      "en": "Visual Meditation Flow",
      "ru": "Визуальная медитация",
      "ro": "Flux de meditație vizuală"
    },
    "description": {
      "en": "Deep relaxation combining palming, breathing, and visualization",
      "ru": "Глубокая релаксация, сочетающая пальминг, дыхание и визуализацию",
      "ro": "Relaxare profundă combinând palmarea, respirația și vizualizarea"
    },
    "duration_sec": 180,
    "difficulty": "intermediate",
    "steps": [
      {
        "step_num": 1,
        "instruction": {
          "en": "Find a comfortable seated position",
          "ru": "Найдите удобное сидячее положение",
          "ro": "Găsiți o poziție șezând confortabilă"
        },
        "duration_sec": 10,
        "audio_base64": null
      },
      {
        "step_num": 2,
        "instruction": {
          "en": "Close eyes and take 5 deep breaths",
          "ru": "Закройте глаза и сделайте 5 глубоких вдохов",
          "ro": "Închideți ochii și faceți 5 respirații profunde"
        },
        "duration_sec": 30,
        "audio_base64": null
      },
      {
        "step_num": 3,
        "instruction": {
          "en": "Rub palms together until very warm",
          "ru": "Потрите ладони до очень теплого состояния",
          "ro": "Frecați palmele până devin foarte calde"
        },
        "duration_sec": 15,
        "audio_base64": null
      },
      {
        "step_num": 4,
        "instruction": {
          "en": "Cup palms over closed eyes gently",
          "ru": "Нежно прикройте ладонями закрытые глаза",
          "ro": "Acoperiți ușor cu palmele ochii închiși"
        },
        "duration_sec": 5,
        "audio_base64": null
      },
      {
        "step_num": 5,
        "instruction": {
          "en": "Visualize complete darkness, breathe deeply",
          "ru": "Визуализируйте полную темноту, дышите глубоко",
          "ro": "Vizualizați întuneric complet, respirați profund"
        },
        "duration_sec": 60,
        "audio_base64": null
      },
      {
        "step_num": 6,
        "instruction": {
          "en": "Imagine a soft green light healing your eyes",
          "ru": "Представьте мягкий зеленый свет, исцеляющий ваши глаза",
          "ro": "Imaginați-vă o lumină verde moale vindecându-vă ochii"
        },
        "duration_sec": 40,
        "audio_base64": null
      },
      {
        "step_num": 7,
        "instruction": {
          "en": "Slowly lower hands, keep eyes closed",
          "ru": "Медленно опустите руки, глаза закрыты",
          "ro": "Coborâți încet mâinile, ochii rămân închiși"
        },
        "duration_sec": 10,
        "audio_base64": null
      },
      {
        "step_num": 8,
        "instruction": {
          "en": "Gently open eyes when ready",
          "ru": "Нежно откройте глаза, когда будете готовы",
          "ro": "Deschideți ușor ochii când sunteți gata"
        },
        "duration_sec": 10,
        "audio_base64": null
      }
    ],
    "is_premium": true,
    "has_audio": false,
    "tags": [
      "advanced",
      "meditation",
      "deep-rest",
      "healing"
    ]
  }
]