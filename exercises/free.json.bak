[
  {
    "id": "20-20-20-rule",
    "title": {
      "en": "20-20-20 Rule",
      "ru": "Правило 20-20-20",
      "ro": "Regula 20-20-20"
    },
    "description": {
      "en": "Take a 20-second break every 20 minutes and look at something 20 feet away",
      "ru": "Каждые 20 минут делайте 20-секундный перерыв и смотрите на что-то в 20 футах",
      "ro": "Faceți o pauză de 20 de secunde la fiecare 20 de minute și uitați-vă la ceva la 20 de picioare distanță"
    },
    "duration_sec": 35,
    "difficulty": "beginner",
    "steps": [
      {
        "step_num": 1,
        "instruction": {
          "en": "Look away from your screen",
          "ru": "Отведите взгляд от экрана",
          "ro": "Uitați-vă departe de ecran"
        },
        "duration_sec": 5,
        "audio_base64": "data:audio/opus;base64,"
      },
      {
        "step_num": 2,
        "instruction": {
          "en": "Focus on an object 20 feet (6 meters) away",
          "ru": "Сосредоточьтесь на объекте в 6 метрах",
          "ro": "Concentrați-vă pe un obiect la 6 metri distanță"
        },
        "duration_sec": 20,
        "audio_base64": null
      },
      {
        "step_num": 3,
        "instruction": {
          "en": "Blink slowly 5 times",
          "ru": "Медленно моргните 5 раз",
          "ro": "Clipiți încet de 5 ori"
        },
        "duration_sec": 10,
        "audio_base64": null
      }
    ],
    "is_premium": false,
    "has_audio": true,
    "tags": [
      "quick",
      "focus"
    ]
  },
  {
    "id": "blinking-drill",
    "title": {
      "en": "Blinking Drill",
      "ru": "Упражнение на моргание",
      "ro": "Exercițiu de clipit"
    },
    "description": {
      "en": "Rapid blinking followed by relaxed blinking to lubricate eyes",
      "ru": "Быстрое моргание с последующим расслабленным морганием для увлажнения глаз",
      "ro": "Clipit rapid urmat de clipit relaxat pentru a lubrifia ochii"
    },
    "duration_sec": 45,
    "difficulty": "beginner",
    "steps": [
      {
        "step_num": 1,
        "instruction": {
          "en": "Blink rapidly for 10 seconds",
          "ru": "Быстро моргайте 10 секунд",
          "ro": "Clipiți rapid timp de 10 secunde"
        },
        "duration_sec": 10,
        "audio_base64": null
      },
      {
        "step_num": 2,
        "instruction": {
          "en": "Close your eyes and relax for 15 seconds",
          "ru": "Закройте глаза и расслабьтесь на 15 секунд",
          "ro": "Închideți ochii și relaxați-vă timp de 15 secunde"
        },
        "duration_sec": 15,
        "audio_base64": null
      },
      {
        "step_num": 3,
        "instruction": {
          "en": "Blink normally 20 times",
          "ru": "Моргните нормально 20 раз",
          "ro": "Clipiți normal de 20 de ori"
        },
        "duration_sec": 20,
        "audio_base64": null
      }
    ],
    "is_premium": false,
    "has_audio": false,
    "tags": [
      "quick",
      "dry-eyes"
    ]
  },
  {
    "id": "eye-rolling",
    "title": {
      "en": "Eye Rolling",
      "ru": "Вращение глазами",
      "ro": "Rotirea ochilor"
    },
    "description": {
      "en": "Gentle circular eye movements to relieve tension",
      "ru": "Мягкие круговые движения глазами для снятия напряжения",
      "ro": "Mișcări circulare blânde ale ochilor pentru a elibera tensiunea"
    },
    "duration_sec": 40,
    "difficulty": "beginner",
    "steps": [
      {
        "step_num": 1,
        "instruction": {
          "en": "Look up, then slowly circle clockwise",
          "ru": "Посмотрите вверх, затем медленно по часовой стрелке",
          "ro": "Uitați-vă în sus, apoi în cerc încet în sens orar"
        },
        "duration_sec": 10,
        "audio_base64": null
      },
      {
        "step_num": 2,
        "instruction": {
          "en": "Repeat 3 times clockwise",
          "ru": "Повторите 3 раза по часовой стрелке",
          "ro": "Repetați de 3 ori în sens orar"
        },
        "duration_sec": 15,
        "audio_base64": null
      },
      {
        "step_num": 3,
        "instruction": {
          "en": "Now circle counterclockwise 3 times",
          "ru": "Теперь против часовой стрелки 3 раза",
          "ro": "Acum în cerc în sens antiorar de 3 ori"
        },
        "duration_sec": 15,
        "audio_base64": null
      }
    ],
    "is_premium": false,
    "has_audio": false,
    "tags": [
      "tension",
      "relaxation"
    ]
  },
  {
    "id": "near-far-focus",
    "title": {
      "en": "Near-Far Focus",
      "ru": "Фокус ближе-дальше",
      "ro": "Focalizare aproape-departe"
    },
    "description": {
      "en": "Alternating focus between near and far objects to strengthen eye muscles",
      "ru": "Чередование фокусировки между близкими и дальними объектами для укрепления глазных мышц",
      "ro": "Focalizare alternativă între obiecte apropiate și îndepărtate pentru a întări mușchii oculari"
    },
    "duration_sec": 50,
    "difficulty": "beginner",
    "steps": [
      {
        "step_num": 1,
        "instruction": {
          "en": "Hold your thumb 10 inches from your face",
          "ru": "Держите большой палец в 25 см от лица",
          "ro": "Țineți degetul mare la 25 cm de față"
        },
        "duration_sec": 5,
        "audio_base64": null
      },
      {
        "step_num": 2,
        "instruction": {
          "en": "Focus on your thumb for 10 seconds",
          "ru": "Сфокусируйтесь на большом пальце 10 секунд",
          "ro": "Concentrați-vă pe degetul mare timp de 10 secunde"
        },
        "duration_sec": 10,
        "audio_base64": null
      },
      {
        "step_num": 3,
        "instruction": {
          "en": "Now focus on something far away for 10 seconds",
          "ru": "Теперь сфокусируйтесь на чем-то далеком 10 секунд",
          "ro": "Acum concentrați-vă pe ceva îndepărtat timp de 10 secunde"
        },
        "duration_sec": 10,
        "audio_base64": null
      },
      {
        "step_num": 4,
        "instruction": {
          "en": "Repeat alternating focus 3 more times",
          "ru": "Повторите чередование фокуса еще 3 раза",
          "ro": "Repetați alternarea focalizării încă de 3 ori"
        },
        "duration_sec": 25,
        "audio_base64": null
      }
    ],
    "is_premium": false,
    "has_audio": false,
    "tags": [
      "focus",
      "strength"
    ]
  },
  {
    "id": "palming",
    "title": {
      "en": "Palming Relaxation",
      "ru": "Пальминг (расслабление)",
      "ro": "Relaxare prin palmare"
    },
    "description": {
      "en": "Warm your hands and cover your eyes to deeply relax eye muscles",
      "ru": "Согрейте руки и закройте глаза для глубокого расслабления глазных мышц",
      "ro": "Încălziți-vă mâinile și acoperiți ochii pentru a relaxa profund mușchii oculari"
    },
    "duration_sec": 60,
    "difficulty": "beginner",
    "steps": [
      {
        "step_num": 1,
        "instruction": {
          "en": "Rub your palms together until warm",
          "ru": "Потрите ладони до тепла",
          "ro": "Frecați-vă palmele până se încălzesc"
        },
        "duration_sec": 10,
        "audio_base64": null
      },
      {
        "step_num": 2,
        "instruction": {
          "en": "Gently cup your palms over closed eyes",
          "ru": "Нежно прикройте ладонями закрытые глаза",
          "ro": "Acoperiți ușor cu palmele ochii închiși"
        },
        "duration_sec": 5,
        "audio_base64": null
      },
      {
        "step_num": 3,
        "instruction": {
          "en": "Breathe slowly and deeply, focus on darkness",
          "ru": "Дышите медленно и глубоко, сфокусируйтесь на темноте",
          "ro": "Respirați încet și profund, concentrați-vă pe întuneric"
        },
        "duration_sec": 40,
        "audio_base64": null
      },
      {
        "step_num": 4,
        "instruction": {
          "en": "Slowly open your eyes",
          "ru": "Медленно откройте глаза",
          "ro": "Deschideți încet ochii"
        },
        "duration_sec": 5,
        "audio_base64": null
      }
    ],
    "is_premium": false,
    "has_audio": false,
    "tags": [
      "relaxation",
      "deep-rest"
    ]
  },
  {
    "id": "figure-eight",
    "title": {
      "en": "Figure Eight Tracing",
      "ru": "Рисование восьмерки",
      "ro": "Trasarea cifrei opt"
    },
    "description": {
      "en": "Trace a figure-eight pattern to improve eye flexibility",
      "ru": "Нарисуйте восьмерку для улучшения гибкости глаз",
      "ro": "Trasați un model în formă de opt pentru a îmbunătăți flexibilitatea ochilor"
    },
    "duration_sec": 45,
    "difficulty": "beginner",
    "steps": [
      {
        "step_num": 1,
        "instruction": {
          "en": "Imagine a large figure-eight 10 feet away",
          "ru": "Представьте большую восьмерку в 3 метрах",
          "ro": "Imaginați-vă un opt mare la 3 metri distanță"
        },
        "duration_sec": 5,
        "audio_base64": null
      },
      {
        "step_num": 2,
        "instruction": {
          "en": "Slowly trace the figure-eight with your eyes",
          "ru": "Медленно нарисуйте восьмерку глазами",
          "ro": "Trasați încet cifra opt cu ochii"
        },
        "duration_sec": 15,
        "audio_base64": null
      },
      {
        "step_num": 3,
        "instruction": {
          "en": "Reverse direction and trace again",
          "ru": "Измените направление и нарисуйте снова",
          "ro": "Inversați direcția și trasați din nou"
        },
        "duration_sec": 15,
        "audio_base64": null
      },
      {
        "step_num": 4,
        "instruction": {
          "en": "Blink and relax",
          "ru": "Моргните и расслабьтесь",
          "ro": "Clipiți și relaxați-vă"
        },
        "duration_sec": 10,
        "audio_base64": null
      }
    ],
    "is_premium": false,
    "has_audio": false,
    "tags": [
      "flexibility",
      "coordination"
    ]
  },
  {
    "id": "zooming",
    "title": {
      "en": "Zooming",
      "ru": "Зумирование",
      "ro": "Zoom"
    },
    "description": {
      "en": "Extend arm forward and slowly bring closer while focusing",
      "ru": "Вытяните руку вперед и медленно приближайте, сохраняя фокус",
      "ro": "Extindeți brațul înainte și apropiați încet în timp ce vă concentrați"
    },
    "duration_sec": 40,
    "difficulty": "beginner",
    "steps": [
      {
        "step_num": 1,
        "instruction": {
          "en": "Extend your arm with thumb pointing up",
          "ru": "Вытяните руку с большим пальцем вверх",
          "ro": "Extindeți brațul cu degetul mare în sus"
        },
        "duration_sec": 5,
        "audio_base64": null
      },
      {
        "step_num": 2,
        "instruction": {
          "en": "Focus on your thumb, slowly bring it closer",
          "ru": "Фокусируйтесь на большом пальце, медленно приближайте",
          "ro": "Concentrați-vă pe degetul mare, apropiați-l încet"
        },
        "duration_sec": 15,
        "audio_base64": null
      },
      {
        "step_num": 3,
        "instruction": {
          "en": "Slowly extend arm back out",
          "ru": "Медленно вытяните руку обратно",
          "ro": "Extindeți încet brațul înapoi"
        },
        "duration_sec": 15,
        "audio_base64": null
      },
      {
        "step_num": 4,
        "instruction": {
          "en": "Repeat 2 more times",
          "ru": "Повторите еще 2 раза",
          "ro": "Repetați încă de 2 ori"
        },
        "duration_sec": 5,
        "audio_base64": null
      }
    ],
    "is_premium": false,
    "has_audio": false,
    "tags": [
      "focus",
      "strength"
    ]
  },
  {
    "id": "side-to-side",
    "title": {
      "en": "Side-to-Side Glance",
      "ru": "Взгляд из стороны в сторону",
      "ro": "Privire de la o parte la alta"
    },
    "description": {
      "en": "Move eyes horizontally to reduce strain from fixed focus",
      "ru": "Двигайте глазами горизонтально для снятия напряжения от фиксированного фокуса",
      "ro": "Mișcați ochii orizontal pentru a reduce oboseala de la focalizarea fixă"
    },
    "duration_sec": 35,
    "difficulty": "beginner",
    "steps": [
      {
        "step_num": 1,
        "instruction": {
          "en": "Look as far right as comfortable",
          "ru": "Посмотрите как можно дальше вправо",
          "ro": "Uitați-vă cât de mult puteți la dreapta"
        },
        "duration_sec": 5,
        "audio_base64": null
      },
      {
        "step_num": 2,
        "instruction": {
          "en": "Now look as far left as comfortable",
          "ru": "Теперь посмотрите как можно дальше влево",
          "ro": "Acum uitați-vă cât de mult puteți la stânga"
        },
        "duration_sec": 5,
        "audio_base64": null
      },
      {
        "step_num": 3,
        "instruction": {
          "en": "Repeat slowly 5 times",
          "ru": "Повторите медленно 5 раз",
          "ro": "Repetați încet de 5 ori"
        },
        "duration_sec": 20,
        "audio_base64": null
      },
      {
        "step_num": 4,
        "instruction": {
          "en": "Blink and center your gaze",
          "ru": "Моргните и центрируйте взгляд",
          "ro": "Clipiți și centrați privirea"
        },
        "duration_sec": 5,
        "audio_base64": null
      }
    ],
    "is_premium": false,
    "has_audio": false,
    "tags": [
      "tension",
      "quick"
    ]
  },
  {
    "id": "up-and-down",
    "title": {
      "en": "Up-and-Down Glance",
      "ru": "Взгляд вверх-вниз",
      "ro": "Privire sus-jos"
    },
    "description": {
      "en": "Move eyes vertically to strengthen eye muscles",
      "ru": "Двигайте глазами вертикально для укрепления глазных мышц",
      "ro": "Mișcați ochii vertical pentru a întări mușchii oculari"
    },
    "duration_sec": 35,
    "difficulty": "beginner",
    "steps": [
      {
        "step_num": 1,
        "instruction": {
          "en": "Look up as high as comfortable",
          "ru": "Посмотрите вверх насколько удобно",
          "ro": "Uitați-vă în sus cât de mult puteți"
        },
        "duration_sec": 5,
        "audio_base64": null
      },
      {
        "step_num": 2,
        "instruction": {
          "en": "Now look down as low as comfortable",
          "ru": "Теперь посмотрите вниз насколько удобно",
          "ro": "Acum uitați-vă în jos cât de mult puteți"
        },
        "duration_sec": 5,
        "audio_base64": null
      },
      {
        "step_num": 3,
        "instruction": {
          "en": "Repeat slowly 5 times",
          "ru": "Повторите медленно 5 раз",
          "ro": "Repetați încet de 5 ori"
        },
        "duration_sec": 20,
        "audio_base64": null
      },
      {
        "step_num": 4,
        "instruction": {
          "en": "Blink and center your gaze",
          "ru": "Моргните и центрируйте взгляд",
          "ro": "Clipiți și centrați privirea"
        },
        "duration_sec": 5,
        "audio_base64": null
      }
    ],
    "is_premium": false,
    "has_audio": false,
    "tags": [
      "tension",
      "quick"
    ]
  },
  {
    "id": "diagonal-stretch",
    "title": {
      "en": "Diagonal Stretch",
      "ru": "Диагональная растяжка",
      "ro": "Întindere diagonală"
    },
    "description": {
      "en": "Move eyes diagonally to work all eye muscles",
      "ru": "Двигайте глазами по диагонали для работы всех глазных мышц",
      "ro": "Mișcați ochii diagonal pentru a lucra toți mușchii oculari"
    },
    "duration_sec": 40,
    "difficulty": "beginner",
    "steps": [
      {
        "step_num": 1,
        "instruction": {
          "en": "Look to upper right corner",
          "ru": "Посмотрите в верхний правый угол",
          "ro": "Uitați-vă în colțul din dreapta sus"
        },
        "duration_sec": 5,
        "audio_base64": null
      },
      {
        "step_num": 2,
        "instruction": {
          "en": "Now to lower left corner",
          "ru": "Теперь в нижний левый угол",
          "ro": "Acum în colțul din stânga jos"
        },
        "duration_sec": 5,
        "audio_base64": null
      },
      {
        "step_num": 3,
        "instruction": {
          "en": "Repeat 3 times",
          "ru": "Повторите 3 раза",
          "ro": "Repetați de 3 ori"
        },
        "duration_sec": 15,
        "audio_base64": null
      },
      {
        "step_num": 4,
        "instruction": {
          "en": "Now upper left to lower right, 3 times",
          "ru": "Теперь верхний левый в нижний правый, 3 раза",
          "ro": "Acum stânga sus la dreapta jos, de 3 ori"
        },
        "duration_sec": 15,
        "audio_base64": null
      }
    ],
    "is_premium": false,
    "has_audio": false,
    "tags": [
      "strength",
      "comprehensive"
    ]
  }
]