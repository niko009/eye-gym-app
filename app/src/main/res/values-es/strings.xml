    <string name="exercise_instruction_up_down">Comenzamos. Mueve lentamente los ojos hacia arriba y luego hacia abajo.</string>
    <string name="exercise_instruction_left_right">Siguiente ejercicio. Mueve lentamente los ojos hacia la derecha y luego hacia la izquierda.</string>
    <string name="exercise_instruction_diagonal">Ahora en diagonal. Mira la esquina superior derecha, luego la inferior izquierda.</string>
    <string name="exercise_instruction_circle">Bien. Ahora gira lentamente los ojos en el sentido de las agujas del reloj.</string>
    <string name="exercise_instruction_blink">Y ahora, parpadea rápidamente durante 10 segundos.</string>
    <string name="exercise_instruction_focus">Enfoca tu dedo frente a tu nariz, luego un objeto lejano.</string>
    <string name="exercise_name_square">Patrón Cuadrado</string>
    <string name="exercise_name_snake">Patrón Serpiente</string>
