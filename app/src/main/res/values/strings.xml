    <string name="exercise_instruction_up_down">Let\'s begin. Slowly move your eyes up, then down.</string>
    <string name="exercise_instruction_left_right">Next exercise. Slowly move your eyes to the right, then to the left.</string>
    <string name="exercise_instruction_diagonal">Now, diagonally. Look at the top right corner, then the bottom left.</string>
    <string name="exercise_instruction_circle">Good. Now slowly rotate your eyes clockwise.</string>
    <string name="exercise_instruction_blink">And now, blink quickly for 10 seconds.</string>
    <string name="exercise_instruction_focus">Focus on your finger in front of your nose, then on a distant object.</string>
